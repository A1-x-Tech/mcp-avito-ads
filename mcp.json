{
  "mcpServers": {
    "avito-ads": {
      "command": "npx",
      "args": ["-y", "mcp-avito-ads@latest"],
      "env": {
        "AVITO_ADS_CLIENT_ID": "${AVITO_ADS_CLIENT_ID}",
        "AVITO_ADS_CLIENT_SECRET": "${AVITO_ADS_CLIENT_SECRET}",
        "AVITO_ADS_ACCOUNT_ID": "${AVITO_ADS_ACCOUNT_ID}"
      }
    }
  }
}
